    {
        "id": "453724b39a199e33",
        "type": "subflow",
        "name": "NightFeedCheck",
        "info": "",
        "category": "",
        "in": [
            {
                "x": 40,
                "y": 200,
                "wires": [
                    {
                        "id": "876dffe95b3f8db0"
                    }
                ]
            }
        ],
        "out": [
            {
                "x": 1560,
                "y": 180,
                "wires": [
                    {
                        "id": "b35e4ed964036017",
                        "port": 0
                    }
                ]
            },
            {
                "x": 1560,
                "y": 240,
                "wires": [
                    {
                        "id": "b35e4ed964036017",
                        "port": 1
                    }
                ]
            },
            {
                "x": 1560,
                "y": 300,
                "wires": [
                    {
                        "id": "b35e4ed964036017",
                        "port": 2
                    }
                ]
            }
        ],
        "env": [],
        "meta": {},
        "color": "#C0C0C0",
        "icon": "font-awesome/fa-sun-o",
        "status": {
            "x": 1460,
            "y": 80,
            "wires": [
                {
                    "id": "49514519f9bdeffa",
                    "port": 0
                },
                {
                    "id": "02955a544ab510d9",
                    "port": 0
                }
            ]
        }
    },
    {
        "id": "b35e4ed964036017",
        "type": "function",
        "z": "453724b39a199e33",
        "name": "Nachteinspeisung",
        "func": "const now = Date.now();\n\nconst solarCfg = msg.cfg?.solar || {};\nconst sunData = msg.sunData || {};\nconst attrs = sunData.attributes || {};\nconst sunState = String(sunData.state || msg.sun || \"\").toLowerCase();\n\nconst season = (msg.season || \"\").toLowerCase();\nconst vacation = msg.vacation === true;\n\n// NOTE:\n// SoC wird hier NICHT für Safety verwendet!\n// Nur zur dynamischen Anpassung des Nightfeed-Startzeitpunkts\nconst soc = Number(msg.soc);\n\nfunction formatLocalDateTime(ts, timeZone = \"Europe/Vienna\") {\n    const parts = new Intl.DateTimeFormat(\"sv-SE\", {\n        timeZone,\n        year: \"numeric\",\n        month: \"2-digit\",\n        day: \"2-digit\",\n        hour: \"2-digit\",\n        minute: \"2-digit\",\n        second: \"2-digit\",\n        hour12: false\n    }).formatToParts(new Date(ts));\n\n    const get = type => parts.find(p => p.type === type)?.value || \"00\";\n\n    return `${get(\"year\")}-${get(\"month\")}-${get(\"day\")} ${get(\"hour\")}:${get(\"minute\")}:${get(\"second\")}`;\n}\n\nfunction getLocalDateKey(ts, timeZone = \"Europe/Vienna\") {\n    const parts = new Intl.DateTimeFormat(\"sv-SE\", {\n        timeZone,\n        year: \"numeric\",\n        month: \"2-digit\",\n        day: \"2-digit\"\n    }).formatToParts(new Date(ts));\n\n    const get = type => parts.find(p => p.type === type)?.value || \"00\";\n    return `${get(\"year\")}-${get(\"month\")}-${get(\"day\")}`;\n}\n\nfunction errorOut(reason) {\n    msg.NightFeedCheckError = reason;\n    msg.payload = null;\n\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: reason\n    });\n\n    return [null, null, msg];\n}\n\nif (!Number.isFinite(soc)) {\n    return errorOut(\"missing/invalid: soc\");\n}\n\nconst cfgNightOffset = Number(solarCfg.night_offset_min ?? 0);\nconst cfgSunriseDelay = Number(solarCfg.sunrise_delay_min ?? 0);\n\n// Bereits gespeichertes Fenster lesen\nlet frozenWindow = context.get(\"nightfeed_window\");\n\n// ======================================================\n// WICHTIGSTER FIX:\n// Wenn eingefrorenes Fenster noch läuft, IMMER weiterverwenden.\n// Egal ob sunState inzwischen above_horizon ist.\n// ======================================================\nconst frozenStillActive =\n    frozenWindow &&\n    Number.isFinite(frozenWindow.start_ts) &&\n    Number.isFinite(frozenWindow.end_ts) &&\n    now <= frozenWindow.end_ts;\n\n// Variablen für Ergebnis\nlet nightKey;\nlet startOffsetMin;\nlet endOffsetMin;\nlet startTs;\nlet endTs;\nlet startLocal;\nlet endLocal;\nlet mode;\n\n// ======================================================\n// Falls altes eingefrorenes Fenster noch gültig läuft:\n// 100% wiederverwenden\n// ======================================================\nif (frozenStillActive) {\n    nightKey = frozenWindow.night_key;\n    startOffsetMin = frozenWindow.start_offset_min;\n    endOffsetMin = frozenWindow.end_offset_min;\n    startTs = frozenWindow.start_ts;\n    endTs = frozenWindow.end_ts;\n    startLocal = frozenWindow.startLocal;\n    endLocal = frozenWindow.endLocal;\n    mode = \"frozen_for_running_window\";\n} else {\n    // Falls altes Fenster abgelaufen ist -> aufräumen\n    if (frozenWindow && now > frozenWindow.end_ts) {\n        context.set(\"nightfeed_window\", null);\n        frozenWindow = null;\n    }\n\n    // ----------------------\n    // Sonnenzeiten aus sun.sun\n    // ----------------------\n    const nextSettingRaw = attrs.next_setting;\n    const nextRisingRaw = attrs.next_rising;\n\n    if (!nextSettingRaw || !nextRisingRaw) {\n        return errorOut(\"missing/invalid: sunData.attributes.next_setting or next_rising\");\n    }\n\n    let sunsetTs = Date.parse(nextSettingRaw);\n    let sunriseTs = Date.parse(nextRisingRaw);\n\n    if (!Number.isFinite(sunsetTs)) {\n        return errorOut(\"missing/invalid: next_setting\");\n    }\n    if (!Number.isFinite(sunriseTs)) {\n        return errorOut(\"missing/invalid: next_rising\");\n    }\n\n    // ----------------------\n    // Wenn Sonne schon unten ist, ist next_setting oft der nächste Sunset.\n    // Für die aktuelle Nacht brauchen wir dann den vorherigen Sunset.\n    // ----------------------\n    if (sunState === \"below_horizon\") {\n        sunsetTs = sunsetTs - (24 * 60 * 60 * 1000);\n    }\n\n    if (![\"spring\", \"summer\", \"autumn\", \"winter\"].includes(season)) {\n        return errorOut(\"missing/invalid: season\");\n    }\n\n    // Nacht-Key über Sunset-Tag\n    nightKey = getLocalDateKey(sunsetTs, \"Europe/Vienna\");\n\n    // ----------------------\n    // Basis Offset dynamisch bestimmen\n    // ----------------------\n    startOffsetMin = 0;\n    endOffsetMin = 60;\n\n    if (season === \"summer\") startOffsetMin = -60;\n    else if (season === \"spring\") startOffsetMin = -30;\n    else if (season === \"autumn\") startOffsetMin = 0;\n    else if (season === \"winter\") startOffsetMin = 60;\n\n    if (vacation) {\n        startOffsetMin -= 60;\n    }\n\n    if (soc >= 90) {\n        startOffsetMin -= 30;\n    } else if (soc >= 75) {\n        startOffsetMin += 0;\n    } else if (soc >= 60) {\n        startOffsetMin += 30;\n    } else {\n        startOffsetMin += 120;\n    }\n\n    // ----------------------\n    // Globale Offsets addieren\n    // ----------------------\n    startOffsetMin += cfgNightOffset;\n    endOffsetMin += cfgSunriseDelay;\n\n    // ----------------------\n    // Zeitfenster berechnen\n    // ----------------------\n    startTs = sunsetTs + (startOffsetMin * 60 * 1000);\n    endTs = sunriseTs + (endOffsetMin * 60 * 1000);\n\n    if (!Number.isFinite(startTs) || !Number.isFinite(endTs)) {\n        return errorOut(\"invalid_start_or_end_ts\");\n    }\n\n    startLocal = formatLocalDateTime(startTs, \"Europe/Vienna\");\n    endLocal = formatLocalDateTime(endTs, \"Europe/Vienna\");\n\n    const activeNow = now >= startTs && now <= endTs;\n\n    // ======================================================\n    // Sobald Nightfeed aktiv ist:\n    // komplette Nachtparameter einfrieren\n    // ======================================================\n    if (activeNow) {\n        frozenWindow = {\n            night_key: nightKey,\n            start_ts: startTs,\n            end_ts: endTs,\n            start_offset_min: startOffsetMin,\n            end_offset_min: endOffsetMin,\n            startLocal: startLocal,\n            endLocal: endLocal,\n            frozen_at: now\n        };\n        context.set(\"nightfeed_window\", frozenWindow);\n        mode = \"frozen_now\";\n    } else {\n        mode = \"dynamic\";\n    }\n}\n\n// Final active immer mit finalen/frozen Werten berechnen\nconst active = now >= startTs && now <= endTs;\n\nmsg.nightfeed = {\n    active,\n    night_key: nightKey,\n    start_ts: startTs,\n    end_ts: endTs,\n    start_offset_min: startOffsetMin,\n    end_offset_min: endOffsetMin,\n    mode: mode,\n    sun_state: sunState,\n    startLocal: startLocal,\n    endLocal: endLocal\n};\n\nmsg.payload = active;\n\nnode.status({\n    fill: active ? \"green\" : \"grey\",\n    shape: \"dot\",\n    text: `${active ? \"on\" : \"off\"} | ${mode} | start ${startOffsetMin}m | end ${endOffsetMin}m`\n});\n\nif (active) {\n    return [msg, null, null];\n} else {\n    return [null, msg, null];\n}",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 200,
        "wires": [
            [
                "49514519f9bdeffa",
                "44d7d97d8006157a"
            ],
            [
                "02955a544ab510d9",
                "44d7d97d8006157a"
            ],
            []
        ]
    },
