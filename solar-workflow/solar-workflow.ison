    {
        "id": "2e99654bbf7f30b7",
        "type": "function",
        "z": "78bef45a5020a183",
        "name": "config",
        "func": "msg.cfg = {\n  light: {\n    default_timeout_sec: 60,\n    long_open_cutoff_min: 30,\n    kitchen: 180\n  },\n\n  solar: {\n    night_offset_min: -30,\n    sunrise_delay_min: 30,\n\n    charger: {\n      prefer_aggressive_on: true,\n\n      temperature: {\n        max_temp: 32,\n        critical_offset: 1\n      },\n\n      chargers: [\n        { id: \"charger1\", num: 1, power: 177, enabled: true },\n        { id: \"charger2\", num: 2, power: 177, enabled: true },\n        { id: \"charger3\", num: 3, power: 300, enabled: true },\n        { id: \"charger4\", num: 4, power: 470, enabled: true }\n      ]\n    },\n\n    max_soc: 98,\n    max_unload_delta: -3,\n    max_float_age_hours: 480,\n    recent_float_age_hours: 60,\n    recent_float_start_soc: 94,\n    recent_float_stop_soc: 92\n  },\n\n  night: {\n    sunset_offset_winter_min: 60,\n    sunset_offset_mid_min: 45,\n    sunset_delay_summer_min: 0,\n    sunrise_delay_winter_min: 0,\n    sunrise_delay_mid_min: 20,\n    sunrise_delay_summer_min: 30,\n    override: false\n  },\n\n  camera: {\n    enabled: true,\n    record: true,\n    snapshot: true,\n    duration_sec: 60,\n    media_dir: \"/config/media\",\n    snapshot_dir: \"/config/www/images\"\n  },\n\n  lametric: {\n    icon: 64076,\n    cycles: 3,\n    icon_type: \"info\",\n    priority: \"info\",\n    sound: \"notification2\",\n    sound_category: \"notifications\",\n    repeat: 1,\n    volume: 50,\n    silent: false\n  }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 210,
        "y": 100,
        "wires": [
            []
        ]
    },
