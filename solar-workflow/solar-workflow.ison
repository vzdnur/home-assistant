        "g": "e3cf3881eb2052d8",
        "name": "override config",
        "func": "const cfg = msg.cfg?.lametric || {};\n\nmsg.icon          = msg.icon          ?? cfg.icon;\nmsg.sound         = msg.sound         ?? cfg.sound;\nmsg.priority      = msg.priority      ?? cfg.priority;\nmsg.icon_type     = msg.icon_type     ?? cfg.icon_type;\nmsg.cycles        = msg.cycles        ?? cfg.cycles;\nmsg.sound_category= msg.sound_category?? cfg.sound_category;\nmsg.lifetime      = msg.lifetime      ?? cfg.lifetime;\n\nreturn msg;",
