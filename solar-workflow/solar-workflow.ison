    {
        "id": "2adc3ef720236c12",
        "type": "function",
        "z": "85069e6b72ec6471",
        "g": "a561941c256a06c0",
        "name": "check",
        "func": "const chargerCfg = msg.cfg?.solar?.charger || {};\n\nconst maxTemp = Number(chargerCfg.temperature?.max_temp);\nconst criticalOffset = Number(chargerCfg.temperature?.critical_offset);\nconst temp = Number(msg.temp);\n\nfunction errorOut(reason) {\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: reason\n    });\n\n    msg.payload = {\n        status: \"error\",\n        title: \"Abstellraum Temperatur Check Fehler\",\n        message: reason\n    };\n\n    return [null, msg];\n}\n\n// ----------------------\n// CONFIG / INPUT CHECK\n// ----------------------\n\nif (!Number.isFinite(maxTemp)) {\n    return errorOut(\"cfg max_temp fehlt/ungültig\");\n}\n\nif (!Number.isFinite(criticalOffset)) {\n    return errorOut(\"cfg critical_offset fehlt/ungültig\");\n}\n\nif (!Number.isFinite(temp)) {\n    return errorOut(\"Temperatur fehlt/ungültig\");\n}\n\nconst criticalTemp = maxTemp + criticalOffset;\n\n// ----------------------\n// STATUS\n// ----------------------\n\nif (temp >= criticalTemp) {\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: `${temp.toFixed(1)}°C kritisch`\n    });\n}\nelse if (temp >= maxTemp) {\n    node.status({\n        fill: \"yellow\",\n        shape: \"dot\",\n        text: `${temp.toFixed(1)}°C warm`\n    });\n}\nelse {\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: `${temp.toFixed(1)}°C ok`\n    });\n}\n\n// ----------------------\n// OK\n// ----------------------\n\nif (temp < maxTemp) {\n    msg.payload = {\n        status: \"ok\",\n        temperature: temp,\n        max_temperature: maxTemp,\n        critical_temperature: criticalTemp\n    };\n\n    return [msg, null];\n}\n\n// ----------------------\n// WARM / KRITISCH\n// ----------------------\n\nmsg.payload = {\n    status: temp >= criticalTemp ? \"critical\" : \"warm\",\n    temperature: temp,\n    max_temperature: maxTemp,\n    critical_temperature: criticalTemp,\n\n    title: temp >= criticalTemp\n        ? \"Abstellraum sehr warm\"\n        : \"Abstellraum warm\",\n\n    message: `Abstellraum hat ${temp.toFixed(1)} °C (Limit ${maxTemp} °C). Ladegeräte/PV prüfen.`\n};\n\nmsg.message = msg.payload.message;\n\nreturn [null, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1320,
        "y": 3200,
        "wires": [
            [],
            [
                "97ebe24327d79cf3"
            ]
        ]
    },
