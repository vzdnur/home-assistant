    {
        "id": "0108ae7f80a01155",
        "type": "function",
        "z": "85069e6b72ec6471",
        "g": "3f7b1721931a5f49",
        "name": "check",
        "func": "const now = Date.now();\n\n// nur den richtigen Pfad nehmen\nconst raw = msg.data?.last_updated ?? null;\n\n// ❌ kein Wert → niemals reboot\nif (!raw || typeof raw !== \"string\") {\n    msg.watchdog = {\n        stale: false,\n        reason: \"missing_last_updated\",\n        raw: raw ?? null\n    };\n    return msg;\n}\n\n// ❌ parse fail → niemals reboot\nconst ts = Date.parse(raw);\n\nif (!Number.isFinite(ts)) {\n    msg.watchdog = {\n        stale: false,\n        reason: \"invalid_timestamp\",\n        raw\n    };\n    return msg;\n}\n\n// nur hier darf überhaupt stale berechnet werden\nconst staleMs = now - ts;\nconst thresholdMs = 3 * 60 * 1000; // 3 min\n\nmsg.watchdog = {\n    stale: staleMs > thresholdMs,\n    stale_ms: staleMs,\n    threshold_ms: thresholdMs,\n    source: \"last_updated\",\n    raw,\n    parsed_at: new Date(ts).toISOString(),\n    now_iso: new Date(now).toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1250,
        "y": 2900,
        "wires": [
            [
                "4003c8af2898f814"
            ]
        ]
    },
    {
        "id": "4003c8af2898f814",
        "type": "switch",
        "z": "85069e6b72ec6471",
        "g": "3f7b1721931a5f49",
        "name": "stale == true",
        "property": "watchdog.stale",
        "propertyType": "msg",
        "rules": [
            {
                "t": "true"
            },
            {
                "t": "else"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 2,
        "x": 1400,
