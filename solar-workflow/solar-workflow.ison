    {
        "id": "ad12f551286e7eaa",
        "type": "function",
        "z": "bd51516d06d28565",
        "name": "SoC",
        "func": "const socRaw = msg.soc;\nconst voltageRaw = msg.voltage;\nconst minSocRaw = msg.min_soc;\nconst season = (msg.season || \"\").toLowerCase();\n\nconst voltage = Number(voltageRaw);\nconst soc = Number(socRaw);\nconst minSoc = Number(minSocRaw);\n\nfunction outOk(reason, minVoltage) {\n    msg.battery_check = {\n        ok: true,\n        type: \"ok\",\n        reason,\n        min_voltage: minVoltage\n    };\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: reason\n    });\n\n    return [msg, null, null, null];\n}\n\nfunction outSocNotOk(reason, minVoltage) {\n    msg.battery_check = {\n        ok: false,\n        type: \"soc_not_ok\",\n        reason,\n        min_voltage: minVoltage\n    };\n\n    node.status({\n        fill: \"yellow\",\n        shape: \"ring\",\n        text: reason\n    });\n\n    return [null, msg, null, null];\n}\n\nfunction outForceOff(reason, minVoltage) {\n    msg.battery_check = {\n        ok: false,\n        type: \"force_socket_off\",\n        reason,\n        min_voltage: minVoltage\n    };\n\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: reason\n    });\n\n    return [null, null, msg, null];\n}\n\nfunction outInvalid(reason) {\n    msg.battery_check = {\n        ok: false,\n        type: \"invalid\",\n        reason\n    };\n\n    node.status({\n        fill: \"grey\",\n        shape: \"ring\",\n        text: reason\n    });\n\n    return [null, null, null, msg];\n}\n\n// ----------------------\n// Fail-safe Season Handling\n// unknown = winter\n// ----------------------\nlet minVoltage;\n\nif (season === \"summer\" || season === \"spring\" || season === \"autumn\") {\n    \n    // minVoltage = 48.2;\n    minVoltage = 48;\n} else {\n    // minVoltage = 49.8;\n    minVoltage = 49.4;\n}\n\n// ----------------------\n// Voltage ist Pflicht\n// invalid/unavailable => Output 4\n// ----------------------\nif (!Number.isFinite(voltage)) {\n    return outInvalid(\"invalid_voltage\");\n}\n\n// ----------------------\n// Hard cut undervoltage => Output 3\n// ----------------------\nif (voltage < minVoltage) {\n    return outForceOff(`undervoltage_${minVoltage}`, minVoltage);\n}\n\n// ----------------------\n// SoC optional\n// invalid SoC allein => okay mit voltage_only\n// minSoc invalid => okay mit voltage_only\n// ----------------------\nconst socExists = Number.isFinite(soc);\nconst minSocExists = Number.isFinite(minSoc);\n\nif (socExists && minSocExists) {\n    if (soc <= minSoc) {\n        return outSocNotOk(`soc_below_min_${minSoc}`, minVoltage);\n    }\n\n    return outOk(\"ok_voltage_soc\", minVoltage);\n}\n\nreturn outOk(\"ok_voltage_only\", minVoltage);",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1090,
        "y": 220,
        "wires": [
            [
                "8de9af99a3e808f5"
            ],
            [
                "a6b68670066642d1"
            ],
            [
                "a6b68670066642d1"
            ],
            [
                "a6b68670066642d1"
            ]
        ]
    },
