    {
        "id": "1d37646eb69403a7",
        "type": "function",
        "z": "0bc88eff15cda6e2",
        "name": "check if allowed",
        "func": "const t = msg || {};\nconst cfg = msg.cfg?.solar || {};\n\nfunction fail(reason) {\n    node.error(reason, msg);\n    return [null, null];\n}\n\n// ----------------------\n// Pflichtfelder prüfen\n// ----------------------\nif (typeof t.vacation_mode !== \"boolean\") return fail(\"missing/invalid: vacation_mode\");\nif (typeof t.nightfeed_active !== \"boolean\") return fail(\"missing/invalid: nightfeed_active\");\n\nif (typeof t.victron1_mode !== \"string\") return fail(\"missing/invalid: victron1_mode\");\n\nif (!Number.isFinite(t.battery_soc)) return fail(\"missing/invalid: battery_soc\");\nif (!Number.isFinite(t.battery_target_soc)) return fail(\"missing/invalid: battery_target_soc\");\nif (!Number.isFinite(cfg.max_soc)) return fail(\"missing/invalid: cfg.max_soc\");\nif (!Number.isFinite(t.wra_power_w)) return fail(\"missing/invalid: wra_power_w\");\n\n// ----------------------\n// Werte normalisieren\n// ----------------------\nconst mode1 = t.victron1_mode.trim().toLowerCase();\nconst batterySoc = t.battery_soc;\nconst batteryTargetSoc = t.battery_target_soc;\nconst hardMaxSoc = cfg.max_soc;\n\nt.victron1_mode = mode1;\n\n// ----------------------\n// Werte validieren\n// ----------------------\nconst allowedModes = [\"bulk\", \"absorption\", \"float\"];\n\nif (!allowedModes.includes(mode1)) return fail(\"invalid value: victron1_mode\");\n\nif (batterySoc < 0 || batterySoc > 100) return fail(\"out of range: battery_soc\");\nif (batteryTargetSoc < 0 || batteryTargetSoc > 100) return fail(\"out of range: battery_target_soc\");\nif (hardMaxSoc < 0 || hardMaxSoc > 100) return fail(\"out of range: cfg.max_soc\");\nif (t.wra_power_w < 0) return fail(\"out of range: wra_power_w\");\n\n// ----------------------\n// Logik\n// ----------------------\nlet allowed = true;\nlet reason = \"ok\";\n\nif (t.vacation_mode) {\n    allowed = false;\n    reason = \"vacation_mode\";\n}\nelse if (t.nightfeed_active) {\n    allowed = false;\n    reason = \"nightfeed_on\";\n}\nelse if (mode1 !== \"bulk\") {\n    allowed = false;\n    reason = \"victron1_not_bulk\";\n}\nelse if (batterySoc >= hardMaxSoc) {\n    allowed = false;\n    reason = \"hard_max_soc\";\n}\nelse if (batterySoc >= batteryTargetSoc) {\n    allowed = false;\n    reason = \"target_soc\";\n}\nelse if (t.wra_power_w >= 20) {\n    allowed = false;\n    reason = \"wra_not_idle\";\n}\n\nmsg.check = {\n    allowed,\n    reason,\n    vacation_mode: t.vacation_mode,\n    nightfeed_active: t.nightfeed_active,\n    victron1_mode: mode1,\n    battery_soc: batterySoc,\n    battery_target_soc: batteryTargetSoc,\n    hard_max_soc: hardMaxSoc,\n    wra_power_w: t.wra_power_w\n};\n\nif (allowed) {\n    return [msg, null];\n} else {\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 400,
        "wires": [
            [
                "f1b9987bfd2dcd83"
            ],
            [
                "a2aa9f1fc05aca8f"
            ]
        ]
    },
