        "z": "3896375fef940d10",
        "name": "isNight?",
        "func": "const now = Date.now();\nconst nowDate = new Date();\n\nconst cfg = msg.cfg?.night || {};\n\nconst forceNight = msg.night_force === \"on\";\n\nconst month = nowDate.getMonth() + 1;\n\nlet sunsetOffsetMin = 0;\nlet sunsetDelayMin = 0;\nlet sunriseDelayMin = 0;\n\nif ([11, 12, 1, 2].includes(month)) {\n    sunsetOffsetMin = Number(cfg.sunset_offset_winter_min ?? 30);\n    sunriseDelayMin = Number(cfg.sunrise_delay_winter_min ?? 0);\n}\nelse if ([3, 4, 9, 10].includes(month)) {\n    sunsetOffsetMin = Number(cfg.sunset_offset_mid_min ?? 20);\n    sunriseDelayMin = Number(cfg.sunrise_delay_mid_min ?? 10);\n}\nelse {\n    sunsetDelayMin = Number(cfg.sunset_delay_summer_min ?? 20);\n    sunriseDelayMin = Number(cfg.sunrise_delay_summer_min ?? 20);\n}\n\nconst nextSetting = msg.sunData?.attributes?.next_setting\n    ? new Date(msg.sunData.attributes.next_setting).getTime()\n    : null;\n\nconst nextRising = msg.sunData?.attributes?.next_rising\n    ? new Date(msg.sunData.attributes.next_rising).getTime()\n    : null;\n\n// ELEVATION als primäre Quelle — nicht auf HA state verlassen\nconst elevation = msg.sunData?.attributes?.elevation ?? null;\nconst sunState = (elevation !== null)\n    ? (elevation < 0 ? \"below_horizon\" : \"above_horizon\")\n    : (msg.sunData?.state ?? msg.sun);\n\n// helper: timestamp -> \"HH:mm\"\nfunction toHHmm(ts) {\n    if (!ts) return null;\n    const d = new Date(ts);\n    return d.getHours().toString().padStart(2, \"0\") + \":\" +\n           d.getMinutes().toString().padStart(2, \"0\");\n}\n\nfunction calcNightStartTs() {\n    if (!nextSetting) return null;\n    const prevSetting = nextSetting - 86400000;\n\n    if (sunsetOffsetMin > 0) {\n        const candidate = nextSetting - sunsetOffsetMin * 60000;\n        return candidate > now ? candidate : prevSetting - sunsetOffsetMin * 60000;\n    }\n    if (sunsetDelayMin > 0) {\n        const candidate = nextSetting + sunsetDelayMin * 60000;\n        return candidate > now ? candidate : prevSetting + sunsetDelayMin * 60000;\n    }\n    return nextSetting > now ? nextSetting : prevSetting;\n}\n\n// --- 1) OVERRIDE ---\nif (forceNight) {\n    msg.isNight = true;\n    msg.reason = \"override\";\n    msg.nightEndsAt = nextRising ? toHHmm(nextRising) : null;\n    msg.nightStartsAt = null;\n    return [null, null, msg];\n}\n\n// --- 2) SUN ABOVE HORIZON ---\nif (sunState === \"above_horizon\") {\n\n    if (nextSetting && sunsetOffsetMin > 0) {\n        const msToSetting = nextSetting - now;\n        if (msToSetting >= 0 && msToSetting <= sunsetOffsetMin * 60000) {\n            msg.isNight = true;\n            msg.reason = \"sunset_offset\";\n            msg.nightEndsAt = nextRising ? toHHmm(nextRising) : null;\n            msg.nightStartsAt = null;\n            return [msg, null, null];\n        }\n    }\n\n    if (nextRising && sunriseDelayMin > 0) {\n        const prevRising = nextRising - 86400000;\n        const msSinceRising = now - prevRising;\n        if (msSinceRising >= 0 && msSinceRising <= sunriseDelayMin * 60000) {\n            const nightEndTs = prevRising + sunriseDelayMin * 60000;\n            msg.isNight = true;\n            msg.reason = \"sunrise_delay\";\n            msg.nightEndsAt = toHHmm(nightEndTs);\n            msg.nightStartsAt = null;\n            return [msg, null, null];\n        }\n    }\n\n    msg.isNight = false;\n    msg.reason = \"day\";\n    msg.nightEndsAt = null;\n    msg.nightStartsAt = toHHmm(calcNightStartTs());\n    return [null, msg, null];\n}\n\n// --- 3) SUN BELOW HORIZON ---\nif (sunState === \"below_horizon\") {\n\n    if (nextSetting && sunsetDelayMin > 0) {\n        const prevSetting = nextSetting - 86400000;\n        const msSinceSetting = now - prevSetting;\n        if (msSinceSetting >= 0 && msSinceSetting <= sunsetDelayMin * 60000) {\n            const nightStartTs = prevSetting + sunsetDelayMin * 60000;\n            msg.isNight = false;\n            msg.reason = \"sunset_delay\";\n            msg.nightEndsAt = null;\n            msg.nightStartsAt = toHHmm(nightStartTs);\n            return [null, msg, null];\n        }\n    }\n\n    msg.isNight = true;\n    msg.reason = \"below_horizon\";\n    msg.nightEndsAt = nextRising ? toHHmm(nextRising) : null;\n    msg.nightStartsAt = null;\n    return [msg, null, null];\n}\n\n// --- 4) FALLBACK ---\nmsg.isNight = false;\nmsg.reason = \"day_fallback\";\nmsg.nightEndsAt = null;\nmsg.nightStartsAt = toHHmm(calcNightStartTs());\nreturn [null, msg, null];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
