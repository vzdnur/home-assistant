                    }
                ]
            }
        ],
        "out": [
            {
                "x": 1680,
                "y": 140,
                "wires": [
                    {
                        "id": "6c43bca86e6d41b2",
                        "port": 0
                    }
                ]
            }
        ],
        "env": [],
        "meta": {},
        "color": "#FFF0F0",
        "icon": "node-red/alert.svg",
        "status": {
            "x": 1860,
            "y": 200,
            "wires": [
