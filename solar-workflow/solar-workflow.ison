    {
        "id": "f0e325fe87ebcf9d",
        "type": "comment",
        "z": "1da43a5d9fffa46d",
        "g": "2c18de4e6ac2de5a",
        "name": "Policy",
        "info": "",
        "x": 330,
        "y": 420,
        "wires": []
    },
    {
        "id": "0667b88ce531d7bb",
        "type": "function",
        "z": "1da43a5d9fffa46d",
        "g": "2c18de4e6ac2de5a",
        "name": "policy",
        "func": "const isNight = msg.isNight ?? false;\n\n// Silent Policy\nif (msg.important) {\n    msg.silent = false; // IMMER laut wenn wichtig\n} else {\n    if (!msg.silent) {\n        msg.silent = isNight; // nachts leise\n    }\n}\n\n// LaMetric Payload immer bauen\nmsg.payload = {\n    message: msg.message,\n    data: {\n        icon: msg.icon,\n        cycles: msg.cycles,\n        icon_type: msg.icon_type,\n        priority: msg.priority\n    }\n};\n\n// Sound nur wenn NICHT silent\nif (!msg.silent) {\n    if (msg.sound) msg.payload.data.sound = msg.sound;\n    if (msg.sound_category) msg.payload.data.sound_category = msg.sound_category;\n    if (msg.volume !== undefined) msg.payload.data.volume = msg.volume;\n}\n\n// Optional: wenn silent → Verhalten überschreiben\nif (msg.silent) {\n    // optional tuning:\n    msg.payload.data.priority = msg.priority ?? \"info\";\n    msg.payload.data.cycles = 1;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 520,
        "wires": [
            [
                "7114ab874205680b",
                "062688ecf5f53f38"
            ]
        ]
    },
