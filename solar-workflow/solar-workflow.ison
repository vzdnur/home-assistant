    {
        "id": "1c91df747b6e7994",
        "type": "function",
        "z": "92373f3a71f59f58",
        "name": "WRLimitController",
        "func": "// ════════════════════════════════════════════════\n// WRLimitController\n// Output 1 = OK\n// Output 2 = ABORT / INVALID\n// ════════════════════════════════════════════════\n\nconst WMAX = 800;\n\n// ── Pflichtfelder prüfen ───────────────────────\nconst gridPowerRaw = Number(msg.grid_power);\nconst wrsRaw = Number(msg.wrs);\nconst panelPowerRaw = Number(msg.panel_power);\nconst fallbackPanel3PowerRaw = Number(msg.fallback_panel3_power);\n\nconst chargeModeRaw = String(msg.chargemode || \"\").trim().toLowerCase();\n\nconst nightfeedActive = msg.nightfeed_active === true;\nconst maxSocUnloadActive = msg.maxsoc_policy?.unload_active === true;\nconst maxSocUnloadReason = msg.maxsoc_policy?.reason || null;\n\n// ── Fehlerfunktion ─────────────────────────────\nfunction abort(reason) {\n    msg.dispatch = {\n        ok: false,\n        reason,\n        inputs: {\n            grid_power: Number.isFinite(gridPowerRaw) ? gridPowerRaw : null,\n            wrs: Number.isFinite(wrsRaw) ? wrsRaw : null,\n            panel_power: Number.isFinite(panelPowerRaw) ? panelPowerRaw : null,\n            fallback_panel3_power: Number.isFinite(fallbackPanel3PowerRaw) ? fallbackPanel3PowerRaw : null, \n            chargemode: chargeModeRaw || null,\n            wmax: WMAX,\n            nightfeed_active: nightfeedActive,\n            maxsoc_unload_active: maxSocUnloadActive,\n            maxsoc_unload_reason: maxSocUnloadReason\n        }\n    };\n\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: reason\n    });\n\n    msg.payload = {\n        fill: \"red\",\n        shape: \"ring\",\n        text: reason\n    };\n\n    return [null, msg];\n}\n\n// ── grid_power und wrs sind Pflicht ────────────\nif (!Number.isFinite(gridPowerRaw)) {\n    return abort(\"grid_power_missing_or_invalid\");\n}\n\nif (!Number.isFinite(wrsRaw)) {\n    return abort(\"wrs_missing_or_invalid\");\n}\n\nconst gridPower = gridPowerRaw;\nconst wrs = wrsRaw;\n\n// ── Deadband gegen Zittern ─────────────────────\n\n// Bei kleinem Import/Export kein neues Limit senden\n\nconst GRID_DEADBAND_W = 25;\n\nif (!maxSocUnloadActive && Math.abs(gridPower) <= GRID_DEADBAND_W) {\n    node.status({\n        fill: \"blue\",\n        shape: \"ring\",\n        text: `deadband ${gridPower}W → no change`\n    });\n\n    return [null, null];\n\n}\n\n// ── wmax prüfen ────────────────────────────────\nconst wmax = Number(WMAX);\nif (!Number.isFinite(wmax) || wmax <= 0) {\n    return abort(\"wmax_missing_or_invalid\");\n}\n\n// ── Panelquellen prüfen ────────────────────────\nconst panelPowerValid = Number.isFinite(panelPowerRaw) && panelPowerRaw >= 0;\nconst fallbackPanel3Valid = Number.isFinite(fallbackPanel3PowerRaw) && fallbackPanel3PowerRaw >= 0;\n\n// Bulk = normales panel_power bevorzugen\n// alles andere = fallback_panel3_power bevorzugen\nconst isBulk = chargeModeRaw === \"bulk\";\n\nlet effectivePanelPower = null;\nlet panelSource = \"none\";\n\nif (isBulk) {\n    if (panelPowerValid) {\n        effectivePanelPower = panelPowerRaw;\n        panelSource = \"panel_power_bulk\";\n    } else if (fallbackPanel3Valid) {\n        effectivePanelPower = fallbackPanel3PowerRaw;\n        panelSource = \"fallback_panel3_bulk_fallback\";\n    }\n} else {\n    if (fallbackPanel3Valid) {\n        effectivePanelPower = fallbackPanel3PowerRaw;\n        panelSource = \"fallback_panel3_non_bulk\";\n    } else if (panelPowerValid) {\n        effectivePanelPower = panelPowerRaw;\n        panelSource = \"panel_power_non_bulk_fallback\";\n    }\n}\n\n// ── panel_power nur Pflicht wenn nightfeed NICHT aktiv ──\nif (!nightfeedActive && !maxSocUnloadActive && !Number.isFinite(effectivePanelPower)) {\n    return abort(\"panel_power_missing_while_nightfeed_inactive\");\n}\n\nlet target_watt = 0;\nlet mode = \"\";\nlet reason = \"\";\nlet base_watt = null;\n\n// ── 1. Max-SoC Policy Sonderfall ───────────────\nif (maxSocUnloadActive) {\n    target_watt = wmax;\n    mode = \"max_soc_unload\";\n    reason = maxSocUnloadReason || \"battery_full_unload\";\n}\n\n// ── 2. Normalfall ──────────────────────────────\nelse {\n    base_watt = Math.round(gridPower + wrs);\n\n    if (base_watt < 0) {\n        base_watt = 0;\n    }\n\n    if (nightfeedActive) {\n        target_watt = base_watt;\n        mode = \"nightfeed\";\n        reason = \"grid_power_plus_wrs\";\n    } else {\n        target_watt = Math.min(base_watt, effectivePanelPower);\n\n        if (base_watt > effectivePanelPower) {\n            mode = \"panel_limited\";\n            reason = `limited_by_${panelSource}`;\n        } else {\n            mode = \"day_panel_mode\";\n            reason = `grid_power_plus_wrs_using_${panelSource}`;\n        }\n    }\n\n    if (target_watt > wmax) {\n        target_watt = wmax;\n    }\n}\n\n// ── Output OK ──────────────────────────────────\nmsg.target_watt = target_watt;\nmsg.dispatch = {\n    ok: true,\n    target_watt,\n    mode,\n    reason,\n    inputs: {\n        grid_power: gridPower,\n        wrs,\n        panel_power: panelPowerValid ? panelPowerRaw : null,\n        fallback_panel3_power: fallbackPanel3Valid ? fallbackPanel3PowerRaw : null,\n        effective_panel_power: Number.isFinite(effectivePanelPower) ? effectivePanelPower : null,\n        panel_source: panelSource,\n        chargemode: chargeModeRaw || null,\n        wmax,\n        nightfeed_active: nightfeedActive,\n        maxsoc_unload_active: maxSocUnloadActive,\n        maxsoc_unload_reason: maxSocUnloadReason\n    },\n    base_watt\n};\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: `${mode} → ${target_watt}W`\n});\n\nmsg.payload = {\n    fill: \"green\",\n    shape: \"dot\",\n    text: `${mode} → ${target_watt}W`\n};\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1550,
        "y": 180,
        "wires": [
            [
                "bb202c0bf31705b4"
            ],
            [
                "278ff00fb8456359"
            ]
        ]
    },
