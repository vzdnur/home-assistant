    {
        "id": "acedd1027947d487",
        "type": "function",
        "z": "7a271514a5c5a1ba",
        "g": "72e1cd8375055854",
        "name": "Normalize & Prepare",
        "func": "// ─── Config ───────────────────────────────────\nconst MIN_WATT = 0;\nconst MAX_WATT = 800;\n\n// ─── Clamp target_watt ───────────────────\nconst raw = Number(msg.target_watt);\nconst target = Number.isFinite(raw)\n    ? Math.max(MIN_WATT, Math.min(MAX_WATT, raw))\n    : 0;\n\nconst inverter = msg.inverter || \"unknown\";\nmsg.payload = target;\nmsg.current_limit = target;\n\n// ---- retry count ----------\nmsg.retry = {\n    count: 0,\n    max: 6\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 140,
        "wires": [
            [
                "757e1561da6fd3a8",
                "63de6d5394bba703"
            ]
        ]
    },
    {
        "id": "4cb79f28b8eba943",
        "type": "function",
        "z": "7a271514a5c5a1ba",
        "g": "72e1cd8375055854",
        "name": "Verify Set Applied",
        "func": "const POWER_FOLLOW_TOLERANCE = 60;\n\nconst newLimit = Number(msg.target_watt) || 0;\nconst storageroom_power = Number(msg.storageroom_power) || 0;\n\nconst delta = Math.abs(newLimit - storageroom_power);\n\nconst ok = delta <= POWER_FOLLOW_TOLERANCE;\n\nmsg.verify = {\n    ok,\n    reason: ok ? \"ok\" : \"power_mismatch\",\n    new_limit: newLimit,\n    storageroom_power,\n    delta,\n    tolerance: POWER_FOLLOW_TOLERANCE\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 600,
        "wires": [
            [
                "78f18f9992a75248"
            ]
        ]
    },
