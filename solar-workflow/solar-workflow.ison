    },
    {
        "id": "a58410801599c012",
        "type": "api-current-state",
        "z": "85069e6b72ec6471",
        "g": "6f69d908a4ec8526",
        "name": "Charger Master Power",
        "server": "8f9c48cf757c713f",
        "version": 3,
        "outputs": 1,
        "halt_if": "",
        "halt_if_type": "num",
        "halt_if_compare": "gte",
        "entity_id": "sensor.battery_chargermaster_energy_power",
        "state_type": "str",
        "blockInputOverrides": true,
        "outputProperties": [
            {
                "property": "chargerMasterPower",
                "propertyType": "msg",
                "value": "number",
                "valueType": "entityState"
            }
        ],
        "for": "0",
        "forType": "num",
        "forUnits": "minutes",
        "override_topic": false,
        "state_location": "payload",
        "override_payload": "msg",
        "entity_location": "data",
        "override_data": "msg",
        "x": 1160,
        "y": 3480,
        "wires": [
            [
                "a431790c253ddaaa"
            ]
        ]
    },
    {
        "id": "a431790c253ddaaa",
        "type": "function",
        "z": "85069e6b72ec6471",
        "g": "6f69d908a4ec8526",
        "name": "checkPlugProblem",
        "func": "// Ausgang 1 = OK / normal\n// Ausgang 2 = Fehler\n\nconst victron = Number(msg.victron);\nconst batteryIn = Number(msg.battery_in);\nconst chargerMasterPower = Number(msg.chargerMasterPower);\nconst chargerAnyOn = msg.chargerAnyOn === true;\n\nif (![victron, batteryIn, chargerMasterPower].every(Number.isFinite)) {\n    node.status({\n        fill: \"grey\",\n        shape: \"ring\",\n        text: \"Ungültige Messwerte\"\n    });\n\n    return [null, null];\n}\n\n// =====================================================\n// CONFIG\n// =====================================================\n\nconst CHARGER_MASTER_IGNORE_BELOW_W = 50;\n\nconst chargerEfficiency = 0.85;\n\nconst batteryAbsoluteToleranceW = 100;\nconst batteryRelativeTolerance = 0.10;\n\nconst requiredFaultCycles = 3;\nconst requiredHealthyCycles = 2;\n\n\n// =====================================================\n// FALL 1:\n// Master unter 50 W -> alles OK\n// =====================================================\n\nif (chargerMasterPower < CHARGER_MASTER_IGNORE_BELOW_W) {\n\n    context.set(\"faultCycles\", 0);\n    context.set(\"healthyCycles\", 0);\n    context.set(\"alarmActive\", false);\n\n    const okMsg = {\n        ...msg,\n        alarm: false,\n        suspicious: false,\n        reason: \"charger_master_below_threshold\",\n        charger_any_on: chargerAnyOn,\n        charger_master_power: chargerMasterPower,\n        payload: {\n            status: \"ok\",\n            charger_any_on: chargerAnyOn,\n            charger_master_power: chargerMasterPower,\n            alarm: false\n        }\n    };\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: `OK · Master ${chargerMasterPower.toFixed(0)} W`\n    });\n\n    return [okMsg, null];\n}\n\n\n// =====================================================\n// FALL 2:\n// Laut Steuerung ALLE Charger AUS,\n// aber Master > 50 W\n//\n// -> SOFORTFEHLER\n// =====================================================\n\nif (!chargerAnyOn) {\n\n    context.set(\"faultCycles\", 0);\n    context.set(\"healthyCycles\", 0);\n    context.set(\"alarmActive\", true);\n\n    const errorMsg = {\n        ...msg,\n        alarm: true,\n        suspicious: true,\n        reason: \"charger_should_be_off_but_power_detected\",\n        charger_any_on: false,\n        charger_master_power: chargerMasterPower,\n        payload:\n            `ACHTUNG: Lade-Steckdose hängt! ` +\n            `Alle Charger laut Steuerung AUS, ` +\n            `aber Charger Master zieht ${chargerMasterPower.toFixed(0)} W. ` +\n            `Schalter Master aus!`\n    };\n\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: `FEHLER · Charger AUS aber ${chargerMasterPower.toFixed(0)} W`\n    });\n\n    return [null, errorMsg];\n}\n\n\n// =====================================================\n// FALL 3:\n// Mindestens ein Charger ist LEGITIM AN.\n//\n// Jetzt muss Charger Master zur erwarteten\n// Battery-In-Leistung dazugerechnet werden.\n// =====================================================\n\nconst expectedBatteryIn =\n    victron +\n    chargerMasterPower * chargerEfficiency;\n\nconst difference =\n    batteryIn - expectedBatteryIn;\n\nconst allowedDifference =\n    batteryAbsoluteToleranceW +\n    expectedBatteryIn * batteryRelativeTolerance;\n\nconst suspicious =\n    difference > allowedDifference;\n\n\n// =====================================================\n// CYCLE LOGIK\n// =====================================================\n\nlet faultCycles = context.get(\"faultCycles\") || 0;\nlet healthyCycles = context.get(\"healthyCycles\") || 0;\nlet alarmActive = context.get(\"alarmActive\") || false;\n\nif (suspicious) {\n    faultCycles++;\n    healthyCycles = 0;\n} else {\n    healthyCycles++;\n    faultCycles = 0;\n}\n\nif (faultCycles >= requiredFaultCycles) {\n    alarmActive = true;\n}\n\nif (healthyCycles >= requiredHealthyCycles) {\n    alarmActive = false;\n}\n\ncontext.set(\"faultCycles\", faultCycles);\ncontext.set(\"healthyCycles\", healthyCycles);\ncontext.set(\"alarmActive\", alarmActive);\n\n\n// =====================================================\n// COMMON DATA\n// =====================================================\n\nconst commonData = {\n    victron,\n    battery_in: batteryIn,\n\n    charger_master_power: chargerMasterPower,\n    charger_any_on: chargerAnyOn,\n    charger_efficiency: chargerEfficiency,\n\n    expected_battery_in:\n        Math.round(expectedBatteryIn * 10) / 10,\n\n    unexplained_power:\n        Math.round(difference * 10) / 10,\n\n    allowed_difference:\n        Math.round(allowedDifference * 10) / 10,\n\n    suspicious,\n    alarm: alarmActive,\n\n    fault_cycles: faultCycles,\n    healthy_cycles: healthyCycles\n};\n\n\n// =====================================================\n// BESTÄTIGTER FEHLER\n// =====================================================\n\nif (alarmActive) {\n\n    const errorMsg = {\n        ...msg,\n        ...commonData,\n\n        payload:\n            `ACHTUNG: Battery-In passt nicht! ` +\n            `Battery In: ${batteryIn.toFixed(0)} W, ` +\n            `erwartet: ${expectedBatteryIn.toFixed(0)} W, ` +\n            `Abweichung: ${difference.toFixed(0)} W.`\n    };\n\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: `FEHLER · Δ ${difference.toFixed(0)} W`\n    });\n\n    return [null, errorMsg];\n}\n\n\n// =====================================================\n// OK / VERDACHT\n// =====================================================\n\nconst okMsg = {\n    ...msg,\n    ...commonData,\n\n    payload: {\n        status: suspicious ? \"verdächtig\" : \"ok\",\n\n        charger_any_on: chargerAnyOn,\n        charger_master_power: chargerMasterPower,\n\n        battery_in: batteryIn,\n        expected_battery_in: Math.round(expectedBatteryIn),\n\n        unexplained_power: Math.round(difference),\n\n        fault_cycles: faultCycles,\n        alarm: false\n    }\n};\n\nnode.status({\n    fill: suspicious ? \"yellow\" : \"green\",\n    shape: suspicious ? \"ring\" : \"dot\",\n\n    text: suspicious\n        ? `Verdacht ${faultCycles}/${requiredFaultCycles} · Δ ${difference.toFixed(0)} W`\n        : `OK · Charger aktiv · Δ ${difference.toFixed(0)} W`\n});\n\nreturn [okMsg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 130,
        "y": 3540,
        "wires": [
