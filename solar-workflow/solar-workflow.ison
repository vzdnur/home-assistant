    },
    {
        "id": "6c43bca86e6d41b2",
        "type": "function",
        "z": "0648d8da827bf133",
        "name": "MaxSocUnloadPolicy",
        "func": "// ════════════════════════════════════════════════\n// MaxSocUnloadPolicy\n// Output 1 = ALWAYS\n// Fail-safe: if anything unclear → unload_active = false\n//\n// Rules:\n// - winter => auto unload always OFF\n// - last float older than cfg.solar.max_float_age_hours => no unload\n// - if max_float_age_hours missing/invalid => ignore last_float completely\n// - if chargemode is absorption/float => treat like soc=max_soc\n// - if last_float is recent => use aggressive thresholds:\n//      recent_float_start_soc / recent_float_stop_soc\n// ════════════════════════════════════════════════\n\nconst now = Date.now();\nconst solarCfg = msg.cfg?.solar || {};\n\nconst VALID_FULL_MODES = [\"absorption\", \"float\"];\nconst INVALID_MODES = [\"unknown\", \"unavailable\", \"none\", \"null\", \"\"];\n\nconst time = \"T\" + (msg.time || \"\");\nconst season = (msg.season || \"\").toLowerCase();\nconst chargeMode = String(msg.chargemode || \"\").trim().toLowerCase();\n\n// ── Inputs / Overrides ─────────────────────────\nconst autoUnloadRequested = msg.auto_unload_enabled === true;\n\n// Winter override: immer AUS\nconst autoUnload = season === \"winter\" ? false : autoUnloadRequested;\n\nconst soc = Number(msg.soc);\n\n// msg override first, then cfg fallback\nconst maxSocRaw = msg.max_soc ?? solarCfg.max_soc;\nconst maxUnloadDeltaRaw = msg.max_unload_delta ?? solarCfg.max_unload_delta;\n\nconst maxSoc = Number(maxSocRaw);\nconst maxUnloadDeltaNum = Number(maxUnloadDeltaRaw);\n\nconst lastFloatRaw = msg.battery_last_float_at;\n\n// global config for float age\nconst maxFloatAgeHoursRaw = solarCfg.max_float_age_hours;\nconst maxFloatAgeHours = Number(maxFloatAgeHoursRaw);\nconst maxFloatAgeHoursValid = Number.isFinite(maxFloatAgeHours) && maxFloatAgeHours > 0;\n\n// recent float aggressive mode config\nconst recentFloatAgeHoursRaw = solarCfg.recent_float_age_hours;\nconst recentFloatStartSocRaw = solarCfg.recent_float_start_soc;\nconst recentFloatStopSocRaw = solarCfg.recent_float_stop_soc;\n\nconst recentFloatAgeHours = Number(recentFloatAgeHoursRaw);\nconst recentFloatStartSoc = Number(recentFloatStartSocRaw);\nconst recentFloatStopSoc = Number(recentFloatStopSocRaw);\n\n// optional only\nconst forecastExists = typeof msg.forecast_unload_allowed === \"boolean\";\nconst forecastAllows = msg.forecast_unload_allowed === true;\n\n// ── Defaults (FAIL-SAFE) ───────────────────────\nlet unloadActive = false;\nlet reason = \"fail_safe_default\";\nlet detail = \"\";\nlet stopSoc = null;\nlet maxUnloadDelta = null;\nlet effectiveSoc = null;\nlet socSource = \"raw_soc\";\n\nlet unloadStartSoc = null;\nlet unloadStopSoc = null;\nlet thresholdMode = \"not_evaluated\";\nlet lastFloatAgeHours = null;\nlet lastFloatValid = false;\nlet lastFloatTooOld = false;\nlet lastFloatIsRecent = false;\n\n// ── Helper: always return one result ───────────\nfunction out() {\n    msg.maxsoc_policy = {\n        unload_active: unloadActive === true,\n        reason,\n        detail,\n\n        season: season || null,\n        chargemode: chargeMode || null,\n        soc_source: socSource,\n\n        auto_unload_requested: autoUnloadRequested,\n        auto_unload_effective: autoUnload,\n\n        current_soc: Number.isFinite(soc) ? soc : null,\n        effective_soc: Number.isFinite(effectiveSoc) ? effectiveSoc : null,\n\n        max_soc: Number.isFinite(maxSoc) ? maxSoc : null,\n        max_unload_delta: Number.isFinite(maxUnloadDelta) ? maxUnloadDelta : null,\n        stop_soc: Number.isFinite(stopSoc) ? stopSoc : null,\n\n        unload_start_soc: Number.isFinite(unloadStartSoc) ? unloadStartSoc : null,\n        unload_stop_soc: Number.isFinite(unloadStopSoc) ? unloadStopSoc : null,\n        threshold_mode: thresholdMode,\n\n        max_float_age_hours: maxFloatAgeHoursValid ? maxFloatAgeHours : null,\n        recent_float_age_hours: Number.isFinite(recentFloatAgeHours) && recentFloatAgeHours > 0 ? recentFloatAgeHours : null,\n        recent_float_start_soc: Number.isFinite(recentFloatStartSoc) ? recentFloatStartSoc : null,\n        recent_float_stop_soc: Number.isFinite(recentFloatStopSoc) ? recentFloatStopSoc : null,\n\n        last_float_raw: lastFloatRaw || null,\n        last_float_valid: lastFloatValid,\n        last_float_age_hours: Number.isFinite(lastFloatAgeHours) ? Math.round(lastFloatAgeHours * 10) / 10 : null,\n        last_float_too_old: lastFloatTooOld,\n        last_float_is_recent: lastFloatIsRecent\n    };\n\n    const statusText = unloadActive\n        ? `UNLOAD | ${thresholdMode} | soc ${Number.isFinite(effectiveSoc) ? effectiveSoc : \"?\"} → stop ${Number.isFinite(unloadStopSoc) ? unloadStopSoc : \"?\"}`\n        : `HOLD | ${reason}${detail ? \" | \" + detail : \"\"}`;\n\n    node.status({\n        fill: unloadActive ? \"green\" : \"grey\",\n        shape: \"dot\",\n        text: statusText + (time ? \" \" + time : \"\")\n    });\n\n    return msg;\n}\n\n// ── Hard block: winter override / feature disabled ───────\nif (season === \"winter\") {\n    reason = \"winter_disabled\";\n    detail = \"auto_unload_forced_off\";\n    thresholdMode = \"blocked\";\n    return out();\n}\n\nif (!autoUnload) {\n    reason = \"auto_unload_disabled\";\n    detail = \"feature_off\";\n    thresholdMode = \"blocked\";\n    return out();\n}\n\n// ── Core input validation ──────────────────────\nif (!Number.isFinite(maxSoc)) {\n    reason = \"missing_max_soc\";\n    detail = \"max_soc_invalid\";\n    thresholdMode = \"invalid_config\";\n    return out();\n}\n\nif (!Number.isFinite(maxUnloadDeltaNum)) {\n    reason = \"missing_max_unload_delta\";\n    detail = \"delta_invalid\";\n    thresholdMode = \"invalid_config\";\n    return out();\n}\n\n// allow both 2 and -2, internally always positive\nmaxUnloadDelta = Math.abs(maxUnloadDeltaNum);\n\nif (maxUnloadDelta <= 0) {\n    reason = \"invalid_max_unload_delta\";\n    detail = `delta=${maxUnloadDeltaNum}`;\n    thresholdMode = \"invalid_config\";\n    return out();\n}\n\nstopSoc = maxSoc - maxUnloadDelta;\n\nif (!Number.isFinite(stopSoc)) {\n    reason = \"invalid_stop_soc\";\n    detail = `max_soc=${maxSoc}, delta=${maxUnloadDelta}`;\n    thresholdMode = \"invalid_config\";\n    return out();\n}\n\n// Standard: echter SoC\nif (Number.isFinite(soc)) {\n    effectiveSoc = soc;\n    socSource = \"raw_soc\";\n}\n\n// Wenn chargemode gültig gesetzt ist und absorption/float,\n// dann wie \"voll\" behandeln, weil Victron oben ist.\nif (chargeMode && !INVALID_MODES.includes(chargeMode) && VALID_FULL_MODES.includes(chargeMode)) {\n    effectiveSoc = maxSoc;\n    socSource = `chargemode_${chargeMode}`;\n}\n\n// Wenn am Ende gar kein usable SoC da ist → fail-safe false\nif (!Number.isFinite(effectiveSoc)) {\n    reason = \"missing_soc\";\n    detail = \"soc_invalid_and_no_nonbulk_chargemode\";\n    thresholdMode = \"invalid_input\";\n    return out();\n}\n\n// ── last_float_at ──────────────────────────────\nif (lastFloatRaw) {\n    const ts = Date.parse(lastFloatRaw);\n\n    if (Number.isFinite(ts)) {\n        lastFloatValid = true;\n        lastFloatAgeHours = (now - ts) / (60 * 60 * 1000);\n\n        if (maxFloatAgeHoursValid) {\n            lastFloatTooOld = lastFloatAgeHours > maxFloatAgeHours;\n        }\n\n        if (Number.isFinite(recentFloatAgeHours) && recentFloatAgeHours > 0) {\n            lastFloatIsRecent = lastFloatAgeHours <= recentFloatAgeHours;\n        }\n    }\n}\n\n// Wenn Float zu alt ist → kein Unload\nif (lastFloatValid && maxFloatAgeHoursValid && lastFloatTooOld) {\n    reason = \"float_too_old\";\n    detail = `block_unload_until_real_float | age=${Math.round(lastFloatAgeHours * 10) / 10}h > ${maxFloatAgeHours}h`;\n    thresholdMode = \"blocked_float_too_old\";\n    return out();\n}\n\n// ── Forecast optional ──────────────────────────\nif (forecastExists && !forecastAllows) {\n    reason = \"forecast_blocked\";\n    detail = \"forecast_unload_allowed=false\";\n    thresholdMode = \"blocked_forecast\";\n    return out();\n}\n\n// ── Dynamic thresholds ─────────────────────────\n// Default:\n// start = maxSoc\n// stop  = maxSoc - abs(maxUnloadDelta)\nunloadStartSoc = maxSoc;\nunloadStopSoc = stopSoc;\nthresholdMode = \"default_max_soc\";\n\n// Wenn last_float frisch ist, darf früher entladen werden\nif (\n    lastFloatIsRecent &&\n    Number.isFinite(recentFloatStartSoc) &&\n    Number.isFinite(recentFloatStopSoc) &&\n    recentFloatStartSoc > recentFloatStopSoc\n) {\n    unloadStartSoc = recentFloatStartSoc;\n    unloadStopSoc = recentFloatStopSoc;\n    thresholdMode = \"recent_float_aggressive\";\n}\n\n// Sicherheitscheck\nif (!Number.isFinite(unloadStartSoc) || !Number.isFinite(unloadStopSoc) || unloadStartSoc <= unloadStopSoc) {\n    reason = \"invalid_dynamic_thresholds\";\n    detail = `start=${unloadStartSoc}, stop=${unloadStopSoc}`;\n    thresholdMode = \"invalid_config\";\n    return out();\n}\n\n// ── Hysterese ──────────────────────────────────\nlet active = context.get(\"maxSocUnloadActive\") === true;\n\n// einschalten\nif (effectiveSoc >= unloadStartSoc) {\n    active = true;\n}\n\n// ausschalten\nif (effectiveSoc <= unloadStopSoc) {\n    active = false;\n}\n\nunloadActive = active;\ncontext.set(\"maxSocUnloadActive\", active);\n\nif (unloadActive) {\n    reason = \"unloading\";\n    detail = `mode=${thresholdMode}, start_soc=${unloadStartSoc}, stop_soc=${unloadStopSoc}`;\n} else {\n    reason = \"not_unloading\";\n\n    if (effectiveSoc < unloadStartSoc) {\n        detail = `mode=${thresholdMode}, start_soc=${unloadStartSoc}, stop_soc=${unloadStopSoc}`;\n    } else {\n        detail = `mode=${thresholdMode}, start_soc=${unloadStartSoc}, stop_soc=${unloadStopSoc}`;\n    }\n}\n\nreturn out();",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1500,
        "y": 160,
        "wires": [
            [
                "094df7db70e91d26"
            ]
        ]
    },
