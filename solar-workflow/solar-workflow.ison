    {
        "id": "91f988521968f654",
        "type": "subflow",
        "name": "ChargerAutoOnOff",
        "info": "",
        "category": "",
        "in": [
            {
                "x": 180,
                "y": 180,
                "wires": [
                    {
                        "id": "e3a13d1d85609852"
                    }
                ]
            }
        ],
        "out": [],
        "env": [
            {
                "name": "force_all_off",
                "type": "bool",
                "value": "false"
            }
        ],
        "meta": {},
        "color": "#FDD0A2",
        "icon": "font-awesome/fa-battery-0",
        "status": {
            "x": 1720,
            "y": 280,
            "wires": [
                {
                    "id": "333150baabb36b9b",
                    "port": 0
                },
                {
                    "id": "b6da58dcfcd8cf54",
                    "port": 0
                },
                {
                    "id": "952716e38e03dd93",
                    "port": 0
                },
                {
                    "id": "934436f04e7c3f91",
                    "port": 0
                }
            ]
        }
    },
    {
        "id": "64bf94fadfd0a759",
        "type": "function",
        "z": "91f988521968f654",
        "g": "bfcc1737eb290bc0",
        "name": "charger new",
        "func": "const t = msg;\n\nconst cfg = msg.cfg.solar.charger;\n\nconst MIN_EXPORT_BUFFER_W = 50;\n\n// Alle Charger inkl. enabled Status\nconst allChargers = cfg.chargers.map(c => ({\n    ...c,\n    on: t[c.id] === true\n}));\n\n// Nur aktivierte Charger dürfen automatisch geschaltet werden\nconst chargers = allChargers.filter(c => c.enabled !== false);\n\nlet result = {\n    charger1: t.charger1,\n    charger2: t.charger2,\n    charger3: t.charger3,\n    charger4: t.charger4\n};\n\n// Disabled Charger immer hart AUS erzwingen\nfor (const c of allChargers) {\n    if (c.enabled === false) {\n        result[c.id] = false;\n    }\n}\n\nlet action = null;\n\n// =====================================================\n// AUTO ON\n// =====================================================\n//\n// Ein Charger darf nur eingeschaltet werden, wenn:\n//\n// export_w >= charger.power + MIN_EXPORT_BUFFER_W\n//\n// Beispiel:\n// export = 300 W\n// charger1 = 177 W\n// Rest = 123 W -> erlaubt\n//\n// charger3 = 300 W\n// Rest = 0 W -> NICHT erlaubt\n//\n// charger3 darf erst ab:\n// 300 + 50 = 350 W Export\n// =====================================================\n\nif (t.export_w > 0) {\n    const offChargers = chargers.filter(c => !c.on);\n\n    if (offChargers.length > 0) {\n\n        const fitting = offChargers.filter(c =>\n            t.export_w >= (c.power + MIN_EXPORT_BUFFER_W)\n        );\n\n        if (fitting.length > 0) {\n\n            // Größten passenden Charger nehmen.\n            //\n            // Bei gleicher Leistung:\n            // kleinere Nummer zuerst EIN.\n            fitting.sort((a, b) => {\n                if (b.power !== a.power) {\n                    return b.power - a.power;\n                }\n\n                return a.num - b.num;\n            });\n\n            const pick = fitting[0];\n\n            result[pick.id] = true;\n            action = `${pick.id}_on`;\n        }\n    }\n}\n\n// =====================================================\n// AUTO OFF\n// =====================================================\n//\n// Bestehende Logik bleibt:\n// Wenn Netzbezug entsteht, wird ein geeigneter Charger\n// abgeschaltet.\n//\n// Erst:\n// kleinster Charger, dessen Leistung >= Import ist.\n//\n// Falls keiner reicht:\n// größten aktiven Charger abschalten.\n// =====================================================\n\nif (!action && t.import_w > 0) {\n    const onChargers = chargers.filter(c => c.on);\n\n    if (onChargers.length > 0) {\n\n        let candidates = onChargers.filter(c =>\n            c.power >= t.import_w\n        );\n\n        let pick = null;\n\n        if (candidates.length > 0) {\n\n            // kleinster ausreichender Charger\n            // bei gleicher Leistung:\n            // höhere Nummer zuerst AUS\n            candidates.sort((a, b) => {\n                if (a.power !== b.power) {\n                    return a.power - b.power;\n                }\n\n                return b.num - a.num;\n            });\n\n            pick = candidates[0];\n\n        } else {\n\n            // Kein einzelner Charger reicht,\n            // deshalb größten aktiven Charger abschalten\n            onChargers.sort((a, b) => {\n                if (b.power !== a.power) {\n                    return b.power - a.power;\n                }\n\n                return b.num - a.num;\n            });\n\n            pick = onChargers[0];\n        }\n\n        result[pick.id] = false;\n        action = `${pick.id}_off`;\n    }\n}\n\n// =====================================================\n// Disabled Charger nochmals hart AUS erzwingen\n// =====================================================\n\nfor (const c of allChargers) {\n    if (c.enabled === false) {\n        result[c.id] = false;\n\n        if (!action && t[c.id] === true) {\n            action = `${c.id}_disabled_off`;\n        }\n    }\n}\n\n// =====================================================\n// OUTPUT\n// =====================================================\n\nmsg.payload = {\n    action,\n    min_export_buffer_w: MIN_EXPORT_BUFFER_W,\n    export_w: t.export_w,\n    import_w: t.import_w,\n\n    ...result\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 280,
        "wires": [
            [
                "4754fe136acf25f9"
            ]
        ]
    },
