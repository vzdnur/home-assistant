    {
        "id": "16bd57c5a877108b",
        "type": "function",
        "z": "7a271514a5c5a1ba",
        "g": "bc91a67df443b276",
        "name": "Retry Counter",
        "func": "// PLACEHOLDER — Erhöht Retry-Zähler\nmsg.retry.count++;\nmsg.retry.can_retry = msg.retry.count < msg.retry.max;\n\nnode.status({\n    fill:  msg.retry.can_retry ? 'yellow' : 'red',\n    shape: 'ring',\n    text:  'attempt ' + msg.retry.count + ' / ' + msg.retry.max\n});\n\nreturn msg;",
        "outputs": 1,
