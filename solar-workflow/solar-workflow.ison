    {
        "id": "a0dee242e9dd29aa",
        "type": "function",
        "z": "91f988521968f654",
        "g": "bfcc1737eb290bc0",
        "name": "all already on?",
        "func": "const t = msg.payload || msg;\n\nconst allOn =\n    t.charger1 === true &&\n    t.charger2 === true &&\n    t.charger3 === true &&\n    t.charger4 === true;\n\nif (allOn) {\n    // Ausgang 1 → alle an\n    return [msg, null];\n} else {\n    // Ausgang 2 → nicht alle an\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1260,
        "y": 660,
        "wires": [
            [
                "6d8304fedbbbbc0d"
            ],
            [
                "20aae21c11ecc179"
            ]
        ]
    },
