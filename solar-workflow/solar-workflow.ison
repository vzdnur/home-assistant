    {
        "id": "e3fb44c5a4f1fe06",
        "type": "api-get-history",
        "z": "85069e6b72ec6471",
        "g": "fecf253973e43cbe",
        "name": "charger1",
        "server": "8f9c48cf757c713f",
        "version": 1,
        "startDate": "",
        "endDate": "",
        "entityId": "switch.battery_charger1_power",
        "entityIdType": "equals",
        "useRelativeTime": true,
        "relativeTime": "5 minutes",
        "flatten": true,
        "outputType": "array",
        "outputLocationType": "msg",
        "outputLocation": "charger1",
        "x": 1000,
        "y": 1840,
        "wires": [
            [
                "296830d8dca73262"
            ]
        ]
    },
    {
        "id": "181e2e0431e810b4",
        "type": "function",
        "z": "85069e6b72ec6471",
        "g": "fecf253973e43cbe",
        "name": "flapping check",
        "func": "// ════════════════════════════════════════════════\n// Solar Charger Flapping Detection\n// Output 1 = FLAPPING / HIGH SWITCHING ACTIVITY\n// Output 2 = NO FLAPPING\n//\n// Ziel:\n// - Hartes Flapping erkennen: einzelner Charger toggelt zu oft\n// - Globale Unruhe erkennen: insgesamt viele Events über alle Charger\n// - Legitimer Sammel-Off von 4 Chargern soll nicht sofort hart anschlagen\n// ════════════════════════════════════════════════\n\n// ── Config ─────────────────────────────────────\nconst WINDOW_SEC = 300;              // 5 Minuten\nconst MIN_EVENTS_PER_CHARGER = 4;    // harter Alarm pro Charger\nconst MIN_EVENTS_GLOBAL = 8;         // weicher/globaler Alarm über alle\nconst MIN_UPTIME_SEC = 600;          // 10 Minuten HA-Uptime\n\nconst windowMs = WINDOW_SEC * 1000;\nconst now = Date.now();\n\n// ── HA Uptime prüfen ───────────────────────────\nlet haStartTs = Date.parse(msg.uptime);\nlet haUptimeSec = 0;\n\nif (Number.isFinite(haStartTs)) {\n    haUptimeSec = Math.floor((now - haStartTs) / 1000);\n}\n\n// Wenn HA noch nicht lange läuft → skip\nif (haUptimeSec < MIN_UPTIME_SEC) {\n    msg.flapping = {\n        detected: false,\n        skipped: true,\n        reason: \"ha_startup\",\n        mode: \"startup_skip\",\n        ha_uptime_sec: haUptimeSec\n    };\n\n    msg.payload = `Kein Flapping (HA Startup ${haUptimeSec}s)`;\n\n    node.status({\n        fill: \"grey\",\n        shape: \"ring\",\n        text: `startup ${haUptimeSec}s`\n    });\n\n    return [null, msg];\n}\n\n// ── Histories einlesen ─────────────────────────\nconst sources = [\n    { name: \"charger1\", history: msg.charger1 || [] },\n    { name: \"charger2\", history: msg.charger2 || [] },\n    { name: \"charger3\", history: msg.charger3 || [] },\n    { name: \"charger4\", history: msg.charger4 || [] }\n];\n\n// ── Events sammeln ─────────────────────────────\nlet events = [];\nlet involved = new Set();\n\nfor (const src of sources) {\n    for (const item of src.history) {\n        if (!item || !item.last_changed) continue;\n\n        const ts = Date.parse(item.last_changed);\n        if (!Number.isFinite(ts)) continue;\n\n        if ((now - ts) <= windowMs) {\n            const state = item.state != null ? String(item.state) : null;\n\n            events.push({\n                charger: src.name,\n                ts,\n                state\n            });\n\n            involved.add(src.name);\n        }\n    }\n}\n\n// ── sortieren ──────────────────────────────────\nevents.sort((a, b) => a.ts - b.ts);\n\nconst involvedChargers = Array.from(involved).sort();\nconst chargerText = involvedChargers.length > 0\n    ? involvedChargers.join(\", \")\n    : \"-\";\n\n// ── Pro Charger zählen ─────────────────────────\nlet perChargerCount = {};\nlet perChargerStates = {};\n\nfor (const e of events) {\n    perChargerCount[e.charger] = (perChargerCount[e.charger] || 0) + 1;\n\n    if (!perChargerStates[e.charger]) {\n        perChargerStates[e.charger] = [];\n    }\n    perChargerStates[e.charger].push({\n        state: e.state,\n        ts: new Date(e.ts).toISOString()\n    });\n}\n\nconst flappingChargers = Object.entries(perChargerCount)\n    .filter(([_, count]) => count >= MIN_EVENTS_PER_CHARGER)\n    .map(([name]) => name)\n    .sort();\n\n// ── Harte / weiche Erkennung ───────────────────\nconst hardFlapDetected = flappingChargers.length > 0;\nconst globalFlapDetected = events.length >= MIN_EVENTS_GLOBAL;\n\n// Gesamtentscheidung:\n// Output 1 bleibt aktiv wenn\n// - harter Charger-Flap\n// - oder global ungewöhnlich viel Schaltaktivität\nconst flapDetected = hardFlapDetected || globalFlapDetected;\n\n// Modus für Debug / Text\nlet detectionMode = \"none\";\nif (hardFlapDetected && globalFlapDetected) {\n    detectionMode = \"hard_and_global\";\n} else if (hardFlapDetected) {\n    detectionMode = \"hard_per_charger\";\n} else if (globalFlapDetected) {\n    detectionMode = \"global_activity\";\n}\n\n// ── Debug Info ─────────────────────────────────\nmsg.flapping = {\n    detected: flapDetected,\n    mode: detectionMode,\n    hard_detected: hardFlapDetected,\n    global_detected: globalFlapDetected,\n    total_count: events.length,\n    window_sec: WINDOW_SEC,\n    min_events_per_charger: MIN_EVENTS_PER_CHARGER,\n    min_events_global: MIN_EVENTS_GLOBAL,\n    ha_uptime_sec: haUptimeSec,\n    involved_chargers: involvedChargers,\n    flapping_chargers: flappingChargers,\n    per_charger_count: perChargerCount,\n    per_charger_states: perChargerStates,\n    events: events.map(e => ({\n        charger: e.charger,\n        state: e.state,\n        ts: new Date(e.ts).toISOString()\n    }))\n};\n\n// ── FLAPPING / HIGH ACTIVITY ───────────────────\nif (flapDetected) {\n    if (hardFlapDetected) {\n        msg.payload = `Flapping erkannt – Charger: ${flappingChargers.join(\", \")} | gesamt ${events.length} Wechsel in ${WINDOW_SEC}s`;\n    } else {\n        msg.payload = `Hohe Schaltaktivität erkannt (${events.length} Wechsel in ${WINDOW_SEC}s) – beteiligt: ${chargerText}`;\n    }\n\n    node.status({\n        fill: hardFlapDetected ? \"red\" : \"yellow\",\n        shape: \"ring\",\n        text: hardFlapDetected\n            ? `FLAP ${events.length}/${WINDOW_SEC}s [${flappingChargers.join(\", \")}]`\n            : `GLOBAL ${events.length}/${WINDOW_SEC}s [${chargerText}]`\n    });\n\n    return [msg, null];\n}\n\n// ── NO FLAPPING ────────────────────────────────\nmsg.payload = `Kein Flapping`;\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: `ok ${events.length}/${WINDOW_SEC}s [${chargerText}]`\n});\n\nreturn [null, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1540,
        "y": 1900,
        "wires": [
            [
                "29c1e567a5d6442c",
                "5bd611ad87beb13f"
            ],
            [
                "df6e4028961eca76"
            ]
        ]
    },
