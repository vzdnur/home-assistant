    {
        "id": "92373f3a71f59f58",
        "type": "subflow",
        "name": "WRLimitController",
        "info": "",
        "category": "",
        "in": [
            {
                "x": 160,
                "y": 180,
                "wires": [
                    {
                        "id": "ae14f5b16574ee52"
                    }
                ]
            }
        ],
        "out": [
            {
                "x": 1780,
                "y": 200,
                "wires": [
                    {
                        "id": "1c91df747b6e7994",
                        "port": 0
                    }
                ]
            },
            {
                "x": 1720,
                "y": 360,
                "wires": [
                    {
                        "id": "1c91df747b6e7994",
                        "port": 1
                    }
                ]
            }
        ],
        "env": [],
        "meta": {},
        "color": "#F3B567",
        "icon": "font-awesome/fa-power-off",
        "status": {
            "x": 1940,
            "y": 120,
            "wires": [
                {
                    "id": "bb202c0bf31705b4",
                    "port": 0
                },
                {
                    "id": "278ff00fb8456359",
                    "port": 0
