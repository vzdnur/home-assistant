    {
        "id": "8605c2f2c1f259e3",
        "type": "function",
        "z": "1da43a5d9fffa46d",
        "g": "317e3a5b77700442",
        "name": "lametric generate call",
        "func": "const apiKey = \"6f317bcc11fe3c81fc165d73be5f40ab7979f74479fddb0d2122406fc035a593\";\n\nmsg.url = \"http://10.10.1.73:8080/api/v2/device/notifications\";\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\",\n    \"Authorization\": \"Basic \" + Buffer.from(\"dev:\" + apiKey).toString(\"base64\")\n};\n\nmsg.payload = {\n    model: {\n        frames: [\n            {\n                icon: msg.icon ?? 64076,\n                text: msg.message\n            }\n        ],\n        sound: {\n            url: msg.sound_url,\n            type: \"mp3\",\n            fallback: {\n                category: msg.sound_category ?? \"notifications\",\n                id: msg.sound ?? \"notification\"\n            }\n        },\n        cycles: msg.cycles ?? 1\n    },\n    priority: msg.priority ?? \"critical\",\n    icon_type: msg.icon_type ?? \"info\",\n    lifetime: msg.lifetime ?? 5000\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
