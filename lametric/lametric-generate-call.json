const apiKey = "XXX";

msg.url = "http://10.10.1.73:8080/api/v2/device/notifications";

msg.headers = {
    "Content-Type": "application/json",
    "Authorization": "Basic " + Buffer.from("dev:" + apiKey).toString("base64")
};

msg.payload = {
    model: {
        frames: [
            {
                icon: msg.icon ?? 64076,
                text: msg.message
            }
        ],
        sound: {
            url: msg.sound_url,
            type: "mp3",
            fallback: {
                category: msg.sound_category ?? "notifications",
                id: msg.sound ?? "notification"
            }
        },
        cycles: msg.cycles ?? 1
    },
    priority: msg.priority ?? "critical",
    icon_type: msg.icon_type ?? "info",
    lifetime: msg.lifetime ?? 5000
};

return msg;
